# Base URL of the Medplum FHIR server. Use https://api.medplum.com/ for Medplum's hosted service.
MEDPLUM_BASE_URL=http://localhost:8103/
# Optional: a Medplum ClientApplication id to use for sign-in (leave blank for the default).
MEDPLUM_CLIENT_ID=
# Portal name shown in the header, sign-in page and browser tab.
MEDPLUM_APP_NAME=The One
# Medplum project ID. Needed for clinic-owned accounts to sign in (npm run seed fills this in).
MEDPLUM_PROJECT_ID=
# FOCOS Connect API used by the case-management integration (demo: node focos-mock/server.mjs).
# DEMO ONLY: values prefixed MEDPLUM_ are visible in the browser; production calls FOCOS server-side.
MEDPLUM_FOCOS_API_URL=http://localhost:4100
MEDPLUM_FOCOS_API_KEY=demo-focos-key
